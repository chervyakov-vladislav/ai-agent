# --- Приложение ---
PORT=3005 # порт HTTP-сервера (Express)
APP_VERSION=0.0.1 # версия приложения
NODE_ENV=development # режим работы: development | production

# --- Внешние API ---
GITHUB_TOKEN=123 # токен GitHub API: получение диффов и файлов PR, публикация ревью
GEMINI_API_KEY=123 # ключ Google Gemini API: LLM-анализ кода

# --- HTTP-клиент ---
RETRY_DELAY=2000 # базовая задержка (мс) между ретраями HTTP-запросов (экспоненциальный бэкофф в withRetry)

# --- Логирование (pino) ---
LOG_LEVEL=debug # уровень логирования: error | warn | info | debug
IS_LOCAL_LOG=false # true — в dev дополнительно писать логи в файл ./logs/app (pino-roll, дневная ротация)
# SERVICE_NAME=ai-reviewer # имя сервиса в логах (необязательная, есть дефолт)

# --- Qdrant (векторная БД) ---
QDRANT_URL=http://localhost:6333 # API Qdrant (dashboard: http://localhost:6333/dashboard)
QDRANT_API_KEY=1234 # ключ Qdrant
QDRANT_SEED_ID=123124dsad # namespace UUIDv5: детерминированные ID чанков — один и тот же чанк получает один и тот же ID при переиндексации

# --- Ollama (локальные эмбеддинги) ---
OLLAMA_URL=http://localhost:11434 # API Ollama
OLLAMA_KEEP_ALIVE=24h # как долго держать модель в памяти после последнего запроса
OLLAMA_NUM_PARALLEL=1 # параллельные запросы: 4 — если есть NVIDIA GPU с 2–3 ГБ свободных, иначе 1
EMBEDDING_MODEL=nomic-embed-text # модель эмбеддингов; коллекции Qdrant создавать под её размер (768) и Distance Cosine

# --- Redis (кеш эмбеддингов + очереди BullMQ) ---
REDIS_HOST=localhost # хост Redis
REDIS_PORT=6379 # порт Redis
REDIS_PASSWORD=1234 # пароль Redis
# noeviction обязателен: при другой политике BullMQ теряет события очереди при переполнении памяти
REDIS_POLICY=noeviction # maxmemory-policy Redis (читает docker-compose, не приложение)

# --- Node.js ---
NODE_OPTIONS="--expose-gc" # флаг сборщика мусора для работы AST-парсера (web-tree-sitter)
