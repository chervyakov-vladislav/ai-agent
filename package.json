{
  "name": "ai-agent",
  "version": "0.0.1",
  "description": "AI-powered Code Review Agent with RAG and Jira integration",
  "author": "Vladislav Chervyakov <chervyakovve@mail.ru>",
  "license": "MIT",
  "homepage": "https://github.com/chervyakov-vladislav/ai-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chervyakov-vladislav/ai-agent.git"
  },
  "bugs": {
    "url": "https://github.com/chervyakov-vladislav/ai-agent/issues"
  },
  "keywords": [
    "ai",
    "code-review",
    "rag",
    "qdrant",
    "ollama",
    "qwen",
    "langchain",
    "automation"
  ],
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.development src/main.ts",
    "build": "vite build",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc",
    "sshtunnel": "ssh -R 3005:localhost:3005 veesp",
    "docker:clean": "docker compose down -v",
    "docker:up:local": "docker compose up -d qdrant ollama redis"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@langchain/ollama": "^1.2.7",
    "@langchain/qdrant": "^1.0.2",
    "@qdrant/js-client-rest": "^1.17.0",
    "axios": "^1.16.0",
    "bullmq": "^5.76.6",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10"
  }
}
